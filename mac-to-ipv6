#!/usr/bin/env python3
"""Derive the IPv6 link-local address from a MAC address (EUI-64)."""

# https://progress.opensuse.org/issues/155824#note-20
import os
import sys

MIN_ARGV = 2


def mac_to_ipv6(mac: str) -> str:
    """Return the IPv6 interface identifier derived from a colon-separated MAC address."""
    byte_strings = mac.split(":")
    flipped_first = f"{int(byte_strings[0], 16) ^ 0b10:02x}"
    octets = [flipped_first, *byte_strings[1:3], "ff", "fe", *byte_strings[3:]]
    return ":".join("".join(pair) for pair in zip(octets[0::2], octets[1::2], strict=False))


def main() -> None:
    """Print the link-local address for the MAC from argv or stdin, prefixed by $prefix."""
    mac = input("Enter mac of host: ") if len(sys.argv) < MIN_ARGV else sys.argv[1]
    prefix = os.environ.get("prefix") or ""  # noqa: SIM112 - the lowercase env var name is the interface
    print(prefix + mac_to_ipv6(mac))


if __name__ == "__main__":
    main()
