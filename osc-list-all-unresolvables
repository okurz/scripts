#!/usr/bin/env python

"""Find all 'unresolvables' for an OBS project.

This can be used to identify which additional direct and indirect dependencies of packages in a project need to be submitted additionally.

Examples:
  $0 home:okurz:my_project
  $0 home:okurz:my_project my_package

"""

import argparse
import logging
import subprocess
import sys

logging.basicConfig()
log = logging.getLogger(sys.argv[0] if __name__ == "__main__" else __name__)

MAX_VERBOSE = 4


class CustomFormatter(argparse.ArgumentDefaultsHelpFormatter, argparse.RawDescriptionHelpFormatter):
    """Preserve multi-line __doc__ and provide default arguments in help strings."""


def parse_args() -> argparse.Namespace:
    """Parse command-line arguments and set the log level from --verbose."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=CustomFormatter)
    parser.add_argument(
        "-v",
        "--verbose",
        help="Increase verbosity level, specify multiple times to increase verbosity",
        action="count",
        default=1,
    )
    parser.add_argument("--dry-run", action="store_true", help="Do not do any write actions on any target")
    parser.add_argument("--project", help="OBS project to list packages for")
    parser.add_argument(
        "--package",
        help="Only list unresolvables for specified package, otherwise shows for all packages in the project",
    )
    args = parser.parse_args()
    verbose_to_log = {0: logging.CRITICAL, 1: logging.ERROR, 2: logging.WARNING, 3: logging.INFO, 4: logging.DEBUG}
    logging_level = logging.DEBUG if args.verbose > MAX_VERBOSE else verbose_to_log[args.verbose]
    log.setLevel(logging_level)
    return args


def call(cmds: list[str], *, dry_run: bool = False) -> int:
    """Run cmds, or echo them as simulated when dry_run is set."""
    log.debug("call: %s", cmds)
    return subprocess.call((["echo", "Simulating: "] if dry_run else []) + cmds)


def default_repo(prj: str) -> None:
    """Run osc meta for the project, the repository lookup is still to be implemented."""
    meta = call(["osc", "meta", "prj", prj])
    assert meta


