#!/usr/bin/env python3
"""Fetch a Redmine ticket with its journals and print it as markdown."""

import os
import sys
from pathlib import Path
from typing import Any

import requests

REQUEST_TIMEOUT = 30
MIN_ARGV = 2
DEFAULT_HOST = "progress.opensuse.org"


def load_config() -> tuple[str | None, str | None]:
    """Return (redmine-host, redmine-token) from ~/.query_redminerc, or (None, None) if absent."""
    config_path = Path.home() / ".query_redminerc"
    if config_path.exists():
        config = {}
        for line in config_path.read_text().strip().splitlines():
            if "=" in line:
                key, val = line.split("=", 1)
                config[key.strip()] = val.strip()
        return config.get("redmine-host"), config.get("redmine-token")
    return None, None


CONFIG_HOST, CONFIG_TOKEN = load_config()


def clean_host(host: str) -> str:
    """Return the bare host name, dropping a scheme the config may carry."""
    return host.replace("https://", "").replace("http://", "")


def issue_url(host: str, ticket_id: str) -> str:
    """Return the web URL of a ticket on the given host."""
    return f"https://{clean_host(host)}/issues/{ticket_id}"


def normalize_ticket_id(raw: str) -> str:
    """Return the ticket id from a bare id, a ticket URL, or a URL ending in .json."""
    if raw.startswith("http"):
        raw = raw.rstrip("/").split("/")[-1]
        if "." in raw:
            raw = raw.split(".")[0]
    return raw


def print_issue(issue: dict[str, Any], ticket_id: str, host: str) -> None:
    """Print the issue header and its description."""
    print(f"## Issue #{issue.get('id')}: {issue.get('subject')}")
    print(f"- Status: {issue.get('status', {}).get('name')}")
    print(f"- Priority: {issue.get('priority', {}).get('name')}")
    print(f"- Assignee: {issue.get('assigned_to', {}).get('name', 'None')}")
    print(f"- URL: {issue_url(host, ticket_id)}")
    print("\n### Description")
    print(issue.get("description"))


def print_journals(journals: list[dict[str, Any]]) -> None:
    """Print the notes of every journal entry that has one."""
    if not journals:
        return
    print("\n### Journals")
    for journal in journals:
        notes = journal.get("notes")
        if not notes:
            continue
        user = journal.get("user", {}).get("name")
        created = journal.get("created_on")
        print(f"#### {user} at {created}")
        print(notes)
        print("-" * 20)


def fetch_ticket(ticket_id: str) -> None:
    """Fetch a Redmine issue with its journals, print it, and exit 1 on request errors."""
    host = os.environ.get("REDMINE_HOST", CONFIG_HOST) or DEFAULT_HOST
    token = os.environ.get("REDMINE_API_TOKEN", CONFIG_TOKEN)
    headers = {"X-Redmine-API-Key": token} if token else {}

    try:
        response = requests.get(
            f"{issue_url(host, ticket_id)}.json?include=journals", headers=headers, timeout=REQUEST_TIMEOUT
        )
        response.raise_for_status()
        issue = response.json().get("issue", {})
    except requests.RequestException as e:
        print(f"Error fetching ticket {ticket_id}: {e}")
        sys.exit(1)

    print_issue(issue, ticket_id, host)
    print_journals(issue.get("journals", []))


def main() -> None:
    """Read the ticket id from argv and fetch it."""
    if len(sys.argv) < MIN_ARGV:
        print("Usage: python redmine_fetcher.py <ticket_id>")
        sys.exit(1)
    fetch_ticket(normalize_ticket_id(sys.argv[1]))


if __name__ == "__main__":
    main()
