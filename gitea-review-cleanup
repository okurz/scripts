#!/usr/bin/env python3
"""Remove my review requests from draft and/or forwarded pull requests on a Gitea instance."""

from __future__ import annotations

import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import TYPE_CHECKING, Any

import httpx
import typer

if TYPE_CHECKING:
    from collections.abc import Callable

app = typer.Typer(add_completion=False, no_args_is_help=True)

DEFAULT_BASE_URL = "https://src.opensuse.org"
DEFAULT_TOKEN_FILE = "~/.gitea_src_opensuse_org_token_public_rw"
PAGE_SIZE = 100
MAX_RETRIES = 5
BASE_BACKOFF_S = 2.0
REQUEST_TIMEOUT_S = 30.0
HTTP_BAD_REQUEST = 400
HTTP_NOT_FOUND = 404
HTTP_GONE = 410
MAX_ERROR_BODY = 140
THROTTLE_STATUSES = frozenset({403, 429, 502, 503})
SKIPPABLE_STATUSES = frozenset({HTTP_NOT_FOUND, HTTP_GONE})


class APIError(Exception):
    """Raised when the Gitea API returns an error or stays throttled."""


@dataclass(frozen=True)
class PullMatch:
    """A review-requested pull request found through the Gitea issue search."""

    repo: str
    number: int
    title: str
    draft: bool

    @property
    def label(self) -> str:
        """The repo!number reference used in log lines."""
        return f"{self.repo}!{self.number}"


def is_forwarded(match: PullMatch) -> bool:
    """Return whether the pull request title marks it as a forwarded-PR batch."""
    return match.title.startswith("Forwarded PRs:")


SELECTORS: dict[str, Callable[[PullMatch], bool]] = {
    "drafts": lambda m: m.draft,
    "forwarded": is_forwarded,
    "both": lambda m: m.draft or is_forwarded(m),
}


def load_token(path: Path) -> str:
    """Read the API token from a file, exiting with a message when missing or empty."""
    if not path.is_file():
        typer.echo(f"error: token file not found: {path}", err=True)
        raise typer.Exit(code=2)
    token = path.read_text(encoding="utf-8").strip()
    if not token:
        typer.echo(f"error: token file is empty: {path}", err=True)
        raise typer.Exit(code=2)
    return token


def is_throttled(response: httpx.Response) -> bool:
    """Return whether the response is a throttle status or a non-JSON reply to retry."""
    if response.status_code in THROTTLE_STATUSES:
        return True
    return "application/json" not in response.headers.get("content-type", "")


def request(
    client: httpx.Client,
    method: str,
    path: str,
    body: dict[str, list[str]] | None = None,
) -> tuple[int, Any]:
    """Issue a request, retrying with exponential backoff on throttling."""
    for attempt in range(MAX_RETRIES):
        if attempt:
            time.sleep(BASE_BACKOFF_S * (2 ** (attempt - 1)))
        response = client.request(method, path, json=body)
        if is_throttled(response):
            continue
        if response.status_code in SKIPPABLE_STATUSES:
            return response.status_code, None
        if response.status_code >= HTTP_BAD_REQUEST:
            msg = f"{method} {path} -> {response.status_code}: {response.text[:MAX_ERROR_BODY]}"
            raise APIError(msg)
        return response.status_code, response.json() if response.content else None
    msg = f"{method} {path}: still throttled after {MAX_RETRIES} attempts"
    raise APIError(msg)


def item_to_match(item: dict[str, Any]) -> PullMatch:
    """Convert one Gitea issue-search item into a PullMatch."""
    return PullMatch(
        repo=item["repository"]["full_name"],
        number=item["number"],
        title=item.get("title", ""),
        draft=bool(item.get("pull_request", {}).get("draft")),
    )


def search_review_requested(client: httpx.Client) -> list[PullMatch]:
    """Collect every pull request that requested review, following pagination."""
    matches: list[PullMatch] = []
    page = 1
    while True:
        url = f"/api/v1/repos/issues/search?review_requested=true&type=pulls&state=open&limit={PAGE_SIZE}&page={page}"
        _, payload = request(client, "GET", url)
        items = payload if isinstance(payload, list) else payload.get("data", [])
        matches.extend(item_to_match(item) for item in items)
        if len(items) < PAGE_SIZE:
            return matches
        page += 1


def print_dry_run(capped: list[PullMatch]) -> None:
    """List every pull request that would be unassigned, changing nothing."""
    for match in capped:
        tags = [tag for tag, hit in (("draft", match.draft), ("forwarded", is_forwarded(match))) if hit]
        typer.echo(f"would unassign {match.label} [{'+'.join(tags)}]")


def unassign_review_requests(
    client: httpx.Client, login: str, capped: list[PullMatch], request_delay: float
) -> tuple[int, int, list[str]]:
    """Drop my review request from each pull request, returning the counts and the failure labels."""
    unassigned = skipped = 0
    failed: list[str] = []
    for match in capped:
        try:
            status, _ = request(
                client,
                "DELETE",
                f"/api/v1/repos/{match.repo}/pulls/{match.number}/requested_reviewers",
                body={"reviewers": [login]},
            )
            status_label = "skip" if status in SKIPPABLE_STATUSES else "unassigned"
            typer.echo(f"{status_label} {match.label}")
            skipped += status in SKIPPABLE_STATUSES
            unassigned += status not in SKIPPABLE_STATUSES
        except APIError as err:
            failed.append(f"{match.label}: {err}")
            typer.echo(f"FAILED {err}", err=True)
        if request_delay:
            time.sleep(request_delay)
    return unassigned, skipped, failed


def report_result(
    client: httpx.Client,
    selector: Callable[[PullMatch], bool],
    capped: list[PullMatch],
    result: tuple[int, int, list[str]],
) -> None:
    """Print the summary and the PRs that still request my review, exiting 1 when the run left work."""
    unassigned, skipped, failed = result
    capped_keys = {(m.repo, m.number) for m in capped}
    remaining = [m for m in search_review_requested(client) if selector(m) and (m.repo, m.number) in capped_keys]
    typer.echo(
        f"done: unassigned={unassigned} skipped={skipped} failed={len(failed)}"
        f" | still requesting my review: {len(remaining)}"
    )
    for match in remaining:
        typer.echo(f"  remaining: {match.label}")
    if failed:
        typer.echo("failures:", err=True)
        for msg in failed:
            typer.echo(f"  {msg}", err=True)
    if failed or remaining:
        raise typer.Exit(code=1)


@app.command()
def main(
    base_url: str = typer.Option(DEFAULT_BASE_URL, "--base-url", help="Gitea instance base URL."),
    token_file: Path = typer.Option(
        Path(DEFAULT_TOKEN_FILE),
        "--token-file",
        help="File containing the API token.",
    ),
    select: str = typer.Option(
        "both",
        "--select",
        help="Which PRs to unassign: drafts | forwarded | both.",
    ),
    dry_run: bool = typer.Option(False, "--dry-run", help="Only list matching PRs, change nothing."),
    limit: int = typer.Option(0, "--limit", help="Safety cap on the number of PRs to process (0 = no cap)."),
    request_delay: float = typer.Option(0.1, "--request-delay", help="Delay in seconds between unassign requests."),
) -> None:
    """Unassign review requests from draft or forwarded pull requests on Gitea."""
    selector = SELECTORS.get(select)
    if selector is None:
        msg = f"--select must be one of: {', '.join(SELECTORS)}"
        raise typer.BadParameter(msg)
    token = load_token(token_file.expanduser())

    with httpx.Client(
        base_url=base_url.rstrip("/"),
        headers={"Authorization": f"token {token}"},
        timeout=REQUEST_TIMEOUT_S,
    ) as client:
        _, me = request(client, "GET", "/api/v1/user")
        login = me["login"]
        typer.echo(f"acting as {login} on {client.base_url}")

        matches = [m for m in search_review_requested(client) if selector(m)]
        capped = matches[:limit] if limit else matches
        typer.echo(
            f"review-requested open PRs matching: {len(matches)}" + (f" | capped to {len(capped)}" if limit else "")
        )
        if dry_run:
            print_dry_run(capped)
            return

        unassigned, skipped, failed = unassign_review_requests(client, login, capped, request_delay)
        report_result(client, selector, capped, (unassigned, skipped, failed))


if __name__ == "__main__":
    sys.exit(app())
