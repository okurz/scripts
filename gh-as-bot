#!/bin/sh
set -eu

CONF_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/review-assistant"
OS_AUTOINST_ENV="$CONF_DIR/write.env"
CLASSIC_ENV="$CONF_DIR/write-classic-public_repo.env"

# The write gate lives in this wrapper, not in an agent harness, so pi, opencode and a human shell
# all hit the same wall. Reads pass; anything that changes forge state needs REVIEW_BOT_POST=1.
is_write() {
    case "${1:-}" in
        api)
            is_graphql=0
            method=""
            method_set=0
            has_field=0
            has_input=0
            query_seen=0
            mutation=0
            prev=""
            for arg in "$@"; do
                case "$prev" in
                    -X|--method)
                        method="$arg"
                        method_set=1
                        ;;
                esac
                case "$arg" in
                    -X?*)
                        method="${arg#-X}"
                        method="${method#=}"
                        method_set=1
                        ;;
                    --method=*)
                        method="${arg#--method=}"
                        method_set=1
                        ;;
                    -f|-F|--field|--raw-field)
                        has_field=1
                        ;;
                    -f?*|-F?*|--field=*|--raw-field=*)
                        has_field=1
                        ;;
                    --input|--form)
                        has_input=1
                        ;;
                    --input=*|--form=*)
                        has_input=1
                        ;;
                esac
                case "$arg" in
                    *query=*)
                        query_seen=1
                        query_value="${arg#*query=}"
                        case "$query_value" in
                            @*|-) mutation=1 ;;
                            *[Mm][Uu][Tt][Aa][Tt][Ii][Oo][Nn]*) mutation=1 ;;
                        esac
                        ;;
                esac
                if [ "$arg" = "graphql" ]; then
                    is_graphql=1
                fi
                prev="$arg"
            done
            method_get=0
            case "$method" in
                [Gg][Ee][Tt]) method_get=1 ;;
            esac
            if [ "$is_graphql" = "1" ]; then
                if [ "$has_input" = "1" ] || [ "$query_seen" = "0" ] || [ "$mutation" = "1" ]; then
                    return 0
                fi
                return 1
            fi
            if [ "$method_set" = "1" ]; then
                if [ "$method_get" = "1" ] && [ "$has_input" = "0" ]; then
                    return 1
                fi
                return 0
            fi
            if [ "$has_field" = "1" ] || [ "$has_input" = "1" ]; then
                return 0
            fi
            return 1
            ;;
        pr)
            case "${2:-}" in
                view|diff|checks|list|status) return 1 ;;
                comment|review) [ "${3:-}" = "list" ] && return 1 ;;
            esac
            return 0
            ;;
        auth|help|version|completion|status) return 1 ;;
    esac
    return 0
}

if [ "${REVIEW_BOT_POST:-}" != "1" ] && is_write "$@"; then
    echo "gh-as-bot: write refused ($*): set REVIEW_BOT_POST=1 to allow bot writes" >&2
    exit 1
fi

# Resolve target repository from arguments (e.g. -R owner/repo, owner/repo#PR, or full GitHub URL)
target=""
for arg in "$@"; do
    case "$arg" in
        https://github.com/*/*)
            target="$(echo "$arg" | sed -E 's|^https://github.com/([^/]+/[^/#?]+).*|\1|')"
            break
            ;;
        github.com/*/*)
            target="$(echo "$arg" | sed -E 's|^github.com/([^/]+/[^/#?]+).*|\1|')"
            break
            ;;
        */*#*)
            target="$(echo "$arg" | sed -E 's|#.*||')"
            break
            ;;
        */*)
            # Check if previous arg was -R / --repo
            ;;
    esac
done

if [ -z "$target" ]; then
    prev=""
    for arg in "$@"; do
        if [ "$prev" = "-R" ] || [ "$prev" = "--repo" ]; then
            target="$arg"
            break
        fi
        prev="$arg"
    done
fi

# If target is still undetermined, try detecting from git remote origin
if [ -z "$target" ] && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
    origin_url="$(git remote get-url origin 2>/dev/null || true)"
    case "$origin_url" in
        *github.com:*)
            target="$(echo "$origin_url" | sed -E 's|.*github.com:([^/]+/[^/.]+)(\.git)?$|\1|')"
            ;;
        *github.com/*)
            target="$(echo "$origin_url" | sed -E 's|.*github.com/([^/]+/[^/.]+)(\.git)?$|\1|')"
            ;;
    esac
fi

# Select token file: write.env for os-autoinst/*, classic token for others
env_file="$OS_AUTOINST_ENV"
case "$target" in
    os-autoinst/*)
        env_file="$OS_AUTOINST_ENV"
        ;;
    ?*)
        if [ -r "$CLASSIC_ENV" ]; then
            env_file="$CLASSIC_ENV"
        fi
        ;;
    *)
        # Default fallback to classic if present, else write.env
        if [ -r "$CLASSIC_ENV" ]; then
            env_file="$CLASSIC_ENV"
        fi
        ;;
esac

if [ ! -r "$env_file" ]; then
    echo "gh-as-bot: token env file not found or not readable: $env_file" >&2
    exit 1
fi

TOKEN="$(sed -n 's/^REVIEW_ASSISTANT_GH_TOKEN=//p' "$env_file")"
if [ -z "$TOKEN" ]; then
    echo "gh-as-bot: REVIEW_ASSISTANT_GH_TOKEN not found in $env_file" >&2
    exit 1
fi

exec env GH_TOKEN="$TOKEN" gh "$@"
