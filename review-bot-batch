#!/usr/bin/env python3
"""Review many pull requests as the review bot, one isolated session per PR.

Resolves a scope (an org or a list of repositories) with ``gh search prs``, drops drafts,
bot-authored PRs and PRs the bot already reviewed on the current head, then ranks the rest:
PRs the bot currently blocks, then unreviewed PRs with at most one human reviewer, then
everything else. ``--only-blocked`` narrows the batch to the blocked PRs alone. One review
session runs serially in the matching local checkout; a blocked PR gets a comment instead of
a second block. A session that finds nothing new posts no review and ends with ``--- REVIEW
SKIPPED``; its head is recorded in ``<cache>/skipped.json`` so a later cycle does not ask again.
The runner defaults to ``pi -p "/review-as-bot <url> --post"``; ``--runner opencode`` uses
``opencode run --command review-as-bot`` instead. Posting is the default; ``--dry-run``
prints each draft instead and leaves ``REVIEW_BOT_POST`` unset so the as-bot wrappers refuse
writes. ``--watch --interval N`` repeats the cycle and gives each cycle
its own log directory. A failing PR is reported and the batch continues.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from pathlib import Path
from typing import TYPE_CHECKING, Any

if TYPE_CHECKING:
    from collections.abc import Callable

BOT_FALLBACK = "os-autoinst-review"
DEFAULT_ROOTS = (Path.home() / "local" / "os-autoinst",)
DEFAULT_CACHE = Path.home() / ".cache" / "review-bot"
DEFAULT_LIMIT = 10
DEFAULT_TIMEOUT = 1200.0
DEFAULT_INTERVAL = 1200.0
MAX_SEARCH_LIMIT = 1000
SEARCH_FIELDS = "number,title,isDraft,author,createdAt,repository"
REVIEW_STATES = frozenset({"APPROVED", "CHANGES_REQUESTED", "COMMENTED"})
REVIEW_ENTRY_FIELDS = 3
JQ_REVIEWS = '.[] | "\\(.user.login)\\t\\(.state)\\t\\(.commit_id)"'
SKIP_MARKER = "--- REVIEW SKIPPED"
SKIP_CACHE = DEFAULT_CACHE / "skipped.json"


@dataclass(frozen=True)
class Candidate:
    """An open PR that may be reviewed in this batch."""

    repo: str
    number: int
    title: str
    author: str
    created_at: str
    is_draft: bool = False

    @property
    def url(self) -> str:
        """Canonical PR URL passed to review-as-bot."""
        return f"https://github.com/{self.repo}/pull/{self.number}"

    @property
    def slug(self) -> str:
        """Filesystem-safe log name."""
        return f"{self.repo.replace('/', '-')}-{self.number}"


@dataclass(frozen=True)
class PrState:
    """Review state that decides priority and whether to post at all."""

    head: str
    reviewed_on_head: bool = False
    has_bot_review: bool = False
    has_bot_block: bool = False
    human_reviewers: int = 0


@dataclass(frozen=True)
class ReviewOutcome:
    """One nested session: posted or approved, deliberately skipped, or failed."""

    ok: bool
    skipped: bool
    log: Path


def still_blocked(bot: list[tuple[str, str]]) -> bool:
    """Return whether the bot's latest decisive review requests changes (a comment neither blocks nor lifts)."""
    decisive = [state for state, _commit in bot if state != "COMMENTED"]
    return bool(decisive) and decisive[-1] == "CHANGES_REQUESTED"


def review_priority(state: PrState) -> int:
    """Rank eligible PRs: existing block, then unreviewed with little human review, then rest."""
    if state.has_bot_block:
        return 0
    if not state.has_bot_review and state.human_reviewers <= 1:
        return 1
    return 2


def run(cmd: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    """Run a command and capture its output without raising on failure."""
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)


def bot_login() -> str:
    """Return the review bot login, falling back to the known identity."""
    res = run(["gh-as-bot", "api", "user", "--jq", ".login"])
    return res.stdout.strip() if res.returncode == 0 and res.stdout.strip() else BOT_FALLBACK


def parse_github_repo(url: str) -> str | None:
    """Return ``owner/repo`` for a GitHub remote URL, else None."""
    match = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?$", url.strip())
    return match.group(1) if match else None


def search_window(limit: int, window: int = 0) -> int:
    """Return how many search results to fetch for a batch of the given size."""
    return min(max(window or max(limit * 10, 50), limit), MAX_SEARCH_LIMIT)


def search_scope(scope: list[str], limit: int, *, oldest: bool, window: int) -> list[Candidate]:
    """Enumerate open PRs for one gh search scope (owner or repository filters)."""
    cmd = [
        "gh-as-bot",
        "search",
        "prs",
        "--state",
        "open",
        "--limit",
        str(search_window(limit, window)),
        "--sort",
        "created",
        "--order",
        "asc" if oldest else "desc",
        "--json",
        SEARCH_FIELDS,
        *scope,
    ]
    res = run(cmd)
    if res.returncode != 0:
        msg = f"gh search prs failed: {res.stderr.strip()}"
        raise RuntimeError(msg)
    return [candidate_from_json(item) for item in json.loads(res.stdout or "[]")]


def search_candidates(
    owners: list[str], repos: list[str], limit: int, *, oldest: bool = False, window: int = 0
) -> list[Candidate]:
    """Enumerate open PRs for the union of owners and explicit repositories."""
    found: dict[tuple[str, int], Candidate] = {}
    for owner in owners:
        for cand in search_scope(["--owner", owner], limit=limit, oldest=oldest, window=window):
            found[cand.repo, cand.number] = cand
    if repos:
        scope = [arg for repo in repos for arg in ("-R", repo)]
        for cand in search_scope(scope, limit=limit, oldest=oldest, window=window):
            found[cand.repo, cand.number] = cand
    return list(found.values())


def candidate_from_json(item: dict[str, Any]) -> Candidate:
    """Build a Candidate from one ``gh search prs --json`` record."""
    author = item.get("author") or {}
    return Candidate(
        repo=item["repository"]["nameWithOwner"],
        number=int(item["number"]),
        title=item.get("title", ""),
        author=author.get("login", ""),
        created_at=item.get("createdAt", ""),
        is_draft=bool(item.get("isDraft")),
    )


def pr_state(cand: Candidate, login: str) -> PrState:
    """Read the head sha, the bot's reviews, and the human reviewer count."""
    view = run([
        "gh-as-bot",
        "pr",
        "view",
        str(cand.number),
        "-R",
        cand.repo,
        "--json",
        "headRefOid",
        "--jq",
        ".headRefOid",
    ])
    if view.returncode != 0:
        msg = f"cannot read head of {cand.repo}#{cand.number}: {view.stderr.strip()}"
        raise RuntimeError(msg)
    head = view.stdout.strip()
    reviews = run([
        "gh-as-bot",
        "api",
        "--paginate",
        f"repos/{cand.repo}/pulls/{cand.number}/reviews?per_page=100",
        "--jq",
        JQ_REVIEWS,
    ])
    if reviews.returncode != 0:
        msg = f"cannot read reviews of {cand.repo}#{cand.number}: {reviews.stderr.strip()}"
        raise RuntimeError(msg)
    entries = [line.split("\t") for line in reviews.stdout.splitlines()]
    entries = [entry for entry in entries if len(entry) == REVIEW_ENTRY_FIELDS and entry[1] in REVIEW_STATES]
    bot = [(state, commit) for user, state, commit in entries if user == login]
    humans = {
        user for user, _state, _commit in entries if user not in {login, cand.author} and not user.endswith("[bot]")
    }
    return PrState(
        head=head,
        reviewed_on_head=any(commit == head for _state, commit in bot),
        has_bot_review=bool(bot),
        has_bot_block=still_blocked(bot),
        human_reviewers=len(humans),
    )


def skip_key(repo: str, number: int) -> str:
    """Return the cache key that records a deliberately skipped PR."""
    return f"{repo}#{number}"


def load_skips(path: Path) -> dict[str, str]:
    """Read the recorded skip heads, treating a missing or malformed cache as empty."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {key: head for key, head in data.items() if isinstance(head, str)}


def save_skips(path: Path, skips: dict[str, str]) -> None:
    """Persist the skip heads so the next cycle does not ask the same question."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(skips, indent=0, sort_keys=True) + "\n", encoding="utf-8")


def record_skip(path: Path, cand: Candidate, state: PrState, skips: dict[str, str]) -> None:
    """Remember that this head needs no review; a new head makes the PR eligible again."""
    skips[skip_key(cand.repo, cand.number)] = state.head
    save_skips(path, skips)


def filter_candidates(
    candidates: list[Candidate],
    login: str,
    *,
    skip_reviewed: bool,
    include_bots: bool = False,
    only_blocked: bool = False,
    skips: dict[str, str] | None = None,
    state_lookup: Callable[[Candidate, str], PrState] | None = None,
) -> tuple[list[Candidate], dict[tuple[str, int], PrState]]:
    """Drop drafts, bot-authored PRs, unblocked PRs and (optionally) heads already handled."""
    skips = skips or {}
    if state_lookup is None:
        state_lookup = pr_state
    kept: list[Candidate] = []
    states: dict[tuple[str, int], PrState] = {}
    for cand in candidates:
        if cand.is_draft or cand.author == login:
            continue
        if not include_bots and cand.author.endswith("[bot]"):
            continue
        try:
            state = state_lookup(cand, login)
        except RuntimeError as err:
            print(f"skip {cand.repo}#{cand.number}: {err}", file=sys.stderr)
            continue
        states[cand.repo, cand.number] = state
        if only_blocked and not state.has_bot_block:
            continue
        if skip_reviewed and (state.reviewed_on_head or skips.get(skip_key(cand.repo, cand.number)) == state.head):
            continue
        kept.append(cand)
    return kept, states


def select_candidates(
    candidates: list[Candidate],
    limit: int,
    *,
    oldest: bool = False,
    states: dict[tuple[str, int], PrState] | None = None,
) -> list[Candidate]:
    """Take the highest-priority PRs, newest (or oldest) first within a priority bucket."""
    ordered = sorted(candidates, key=lambda cand: cand.created_at, reverse=not oldest)
    if states:
        ordered.sort(key=lambda cand: review_priority(states[cand.repo, cand.number]))
    return ordered[:limit]


def discover_checkouts(roots: list[Path] | tuple[Path, ...]) -> dict[str, Path]:
    """Map ``owner/repo`` to a local checkout under the given roots."""
    found: dict[str, Path] = {}
    for root in roots:
        if not root.is_dir():
            continue
        for config in sorted(root.glob("*/.git/config")):
            checkout = config.parent.parent
            res = run(["git", "-C", str(checkout), "remote", "get-url", "origin"])
            repo = parse_github_repo(res.stdout) if res.returncode == 0 else None
            if repo and repo not in found:
                found[repo] = checkout
    return found


def ensure_checkout(repo: str, checkouts: dict[str, Path], cache: Path, *, allow_clone: bool) -> Path:
    """Return a local checkout for the repo, cloning into the cache if allowed."""
    if repo in checkouts:
        return checkouts[repo]
    target = cache / repo.replace("/", "-")
    if target.is_dir():
        return target
    if not allow_clone:
        msg = f"no local checkout for {repo} (use without --no-clone to clone)"
        raise RuntimeError(msg)
    target.parent.mkdir(parents=True, exist_ok=True)
    res = run(["git", "clone", "--filter=blob:none", "--no-checkout", f"https://github.com/{repo}.git", str(target)])
    if res.returncode != 0:
        msg = f"cannot clone {repo}: {res.stderr.strip()}"
        raise RuntimeError(msg)
    return target


def fetch_pr_head(checkout: Path, number: int) -> None:
    """Fetch the PR head ref so the review session can create a worktree from it."""
    res = run(["git", "-C", str(checkout), "fetch", "--no-tags", "origin", f"refs/pull/{number}/head"])
    if res.returncode != 0:
        msg = f"cannot fetch PR head for #{number}: {res.stderr.strip()}"
        raise RuntimeError(msg)


def review_command(
    cand: Candidate,
    checkout: Path,
    *,
    runner: str = "pi",
    dry_run: bool,
    model: str = "",
    auto: bool = False,
    comment_only: bool = False,
    extra_args: list[str] | None = None,
) -> list[str]:
    """Build the nested review invocation for one PR with the selected runner."""
    mode = "--dry-run" if dry_run else "--post"
    suffix = " --comment" if comment_only else ""
    extra = extra_args or []
    if runner == "opencode":
        flags = [*(["--auto"] if auto else []), *(["-m", model] if model else []), *extra]
        return [
            "opencode",
            "run",
            "--dir",
            str(checkout.resolve()),
            *flags,
            "--command",
            "review-as-bot",
            f"{cand.url} {mode}{suffix}",
        ]
    flags = [*(["--model", model] if model else []), *extra]
    return ["pi", *flags, "-p", f"/review-as-bot {cand.url} {mode}{suffix}"]


def runner_env(*, dry_run: bool) -> dict[str, str]:
    """Environment for the nested runner; the as-bot wrappers refuse writes without REVIEW_BOT_POST."""
    env = dict(os.environ)
    env.pop("REVIEW_BOT_POST", None)
    if not dry_run:
        env["REVIEW_BOT_POST"] = "1"
    return env


def review_succeeded(returncode: int, output: str) -> bool:
    """Treat a claimed block or a failed run as unsuccessful even on exit 0."""
    blocked = "--- REVIEW FAILED" in output or "--- REVIEW BLOCKED" in output
    return returncode == 0 and not blocked


def review_skipped(output: str) -> bool:
    """Return whether the session had nothing new and posted no review on purpose."""
    return SKIP_MARKER in output


def run_review(
    cand: Candidate,
    checkout: Path,
    *,
    runner: str = "pi",
    dry_run: bool,
    model: str = "",
    auto: bool = False,
    comment_only: bool = False,
    extra_args: list[str] | None = None,
    log_dir: Path,
    timeout: float,
) -> ReviewOutcome:
    """Run one review session and tee its output to a log."""
    fetch_pr_head(checkout, cand.number)
    log_dir.mkdir(parents=True, exist_ok=True)
    log = log_dir / f"{cand.slug}.log"
    cmd = review_command(
        cand,
        checkout,
        runner=runner,
        dry_run=dry_run,
        model=model,
        auto=auto,
        comment_only=comment_only,
        extra_args=extra_args,
    )
    timed_out = False
    with log.open("w", encoding="utf-8") as handle:
        try:
            res = subprocess.run(
                cmd,
                cwd=checkout,
                env=runner_env(dry_run=dry_run),
                stdout=handle,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            timed_out = True
    if timed_out:
        with log.open("a", encoding="utf-8") as handle:
            handle.write(f"\n--- REVIEW FAILED (timeout after {timeout:.0f}s) ---\n")
        return ReviewOutcome(ok=False, skipped=False, log=log)
    output = log.read_text(encoding="utf-8", errors="replace")
    return ReviewOutcome(ok=review_succeeded(res.returncode, output), skipped=review_skipped(output), log=log)


def confirm_posted(cand: Candidate, login: str, outcome: ReviewOutcome, *, dry_run: bool) -> bool:
    """Treat the head state from the API as the source of truth, even on exit 0."""
    if outcome.skipped or dry_run:
        return outcome.ok
    try:
        return pr_state(cand, login).reviewed_on_head
    except RuntimeError:
        return False


def cycle_log_dir(base: Path, cycle: int) -> Path:
    """Return a unique log directory for one watch cycle."""
    return base / f"{time.strftime('%Y%m%d-%H%M%S')}-{cycle:03d}"


def infer_owner() -> str:
    """Infer the GitHub owner from the current checkout's origin."""
    res = run(["git", "remote", "get-url", "origin"])
    repo = parse_github_repo(res.stdout) if res.returncode == 0 else None
    return repo.split("/")[0] if repo else ""


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse the command line."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--owner", action="append", default=[], help="GitHub org/user to review, repeatable (default: inferred)"
    )
    parser.add_argument("-R", "--repo", action="append", default=[], dest="repos", help="owner/repo, repeatable")
    parser.add_argument(
        "--limit", type=int, default=DEFAULT_LIMIT, help=f"max PRs to review (default: {DEFAULT_LIMIT})"
    )
    parser.add_argument("--list", action="store_true", help="print the selected PRs and exit without reviewing")
    parser.add_argument("--oldest", action="store_true", help="sweep the oldest open PRs instead of the newest")
    parser.add_argument(
        "--window", type=int, default=0, help="open PRs to search before filtering (default: 10x limit, min 50)"
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"seconds per PR before killing the nested runner (default: {DEFAULT_TIMEOUT:.0f})",
    )
    parser.add_argument("--watch", action="store_true", help="run cycles continuously instead of exiting")
    parser.add_argument(
        "--interval",
        type=float,
        default=DEFAULT_INTERVAL,
        help=f"seconds between watch cycles (default: {DEFAULT_INTERVAL:.0f})",
    )
    parser.add_argument("--dry-run", action="store_true", help="print each draft instead of posting (default: post)")
    parser.add_argument(
        "--recheck",
        action="store_true",
        help="also review heads the bot already reviewed or skipped as having nothing new",
    )
    parser.add_argument(
        "--only-blocked",
        action="store_true",
        help="only consider PRs the bot still blocks with a changes-requested review",
    )
    parser.add_argument("--include-bots", action="store_true", help="include PRs authored by dependency bots")
    parser.add_argument("--no-clone", action="store_true", help="skip repos with no local checkout instead of cloning")
    parser.add_argument("--root", action="append", default=[], dest="roots", help="checkout root, repeatable")
    parser.add_argument("--log-dir", default="", help="directory for per-PR logs (default: ~/.cache/review-bot/logs)")
    parser.add_argument(
        "--runner",
        choices=("pi", "opencode"),
        default="pi",
        help="nested review runner (default: pi)",
    )
    parser.add_argument("--model", default="", help="model passed to the nested runner (opencode: -m, pi: --model)")
    parser.add_argument("--auto", action="store_true", help="pass --auto to opencode to auto-approve permissions")
    parser.add_argument(
        "--runner-arg",
        "--pi-arg",
        action="append",
        default=[],
        dest="runner_args",
        help="extra argument for the nested runner, repeatable; use --runner-arg=--flag for dash values",
    )
    return parser.parse_args(argv)


def review_candidate(
    cand: Candidate,
    state: PrState,
    *,
    args: argparse.Namespace,
    checkouts: dict[str, Path],
    log_dir: Path,
    login: str,
    skips: dict[str, str],
    skip_cache: Path,
) -> bool:
    """Review one candidate and return whether its head now needs no further review."""
    print(f"reviewing {cand.repo}#{cand.number}: {cand.title[:60]}", file=sys.stderr)
    try:
        checkout = ensure_checkout(cand.repo, checkouts, DEFAULT_CACHE, allow_clone=not args.no_clone)
        outcome = run_review(
            cand,
            checkout,
            runner=args.runner,
            dry_run=args.dry_run,
            model=args.model,
            auto=args.auto,
            comment_only=state.has_bot_block,
            extra_args=args.runner_args,
            log_dir=log_dir,
            timeout=args.timeout,
        )
    except RuntimeError as err:
        print(f"FAILED  {cand.repo}#{cand.number}: {err}", file=sys.stderr)
        return False
    if outcome.skipped:
        record_skip(skip_cache, cand, state, skips)
    ok = confirm_posted(cand, login, outcome, dry_run=args.dry_run)
    status = "skip" if outcome.skipped else ("ok" if ok else "FAILED")
    print(f"{status}  {cand.repo}#{cand.number}  log={outcome.log}", file=sys.stderr)
    return ok


def run_cycle(args: argparse.Namespace) -> int:
    """Run one search, filter, select and review cycle and return a shell exit code."""
    owners = [owner for owner in (args.owner or ([infer_owner()] if not args.repos else [])) if owner]
    if not owners and not args.repos:
        print("error: give --owner or -R owner/repo (or run inside a checkout)", file=sys.stderr)
        return 2
    login = bot_login()
    window = search_window(args.limit, args.window)
    try:
        found = search_candidates(owners, args.repos, args.limit, oldest=args.oldest, window=window)
    except (RuntimeError, OSError, ValueError) as err:
        print(f"search failed: {err}", file=sys.stderr)
        return 1
    skips = load_skips(SKIP_CACHE)
    kept, states = filter_candidates(
        found,
        login,
        skip_reviewed=not args.recheck,
        include_bots=args.include_bots,
        only_blocked=args.only_blocked,
        skips=skips,
    )
    candidates = select_candidates(kept, args.limit, oldest=args.oldest, states=states)
    if not candidates:
        end = "oldest" if args.oldest else "newest"
        print(
            f"no reviewable PRs among the {end} {window} open PRs for {', '.join(args.repos or owners)}",
            file=sys.stderr,
        )
        if not args.oldest:
            print("use --oldest to sweep the backlog or raise --window to look deeper", file=sys.stderr)
        return 0
    if args.list:
        for cand in candidates:
            print(f"{cand.repo}#{cand.number}\t{cand.created_at[:10]}\t{cand.author}\t{cand.title}")
        return 0
    mode = "dry-run" if args.dry_run else "post"
    print(f"{len(candidates)} PR(s), mode={mode}, reviewer={login}", file=sys.stderr)
    roots = [Path(root).expanduser() for root in args.roots] or list(DEFAULT_ROOTS)
    checkouts = discover_checkouts(roots)
    log_dir = Path(args.log_dir).expanduser() if args.log_dir else DEFAULT_CACHE / "logs"
    failures = 0
    for cand in candidates:
        state = states[cand.repo, cand.number]
        if not review_candidate(
            cand,
            state,
            args=args,
            checkouts=checkouts,
            log_dir=log_dir,
            login=login,
            skips=skips,
            skip_cache=SKIP_CACHE,
        ):
            failures += 1
    print(f"done: {len(candidates) - failures} ok, {failures} failed", file=sys.stderr)
    return 1 if failures else 0


def run_watch_cycle(args: argparse.Namespace, base: Path, cycle: int) -> None:
    """Run one watch cycle with its own log directory, keeping the loop alive on failure."""
    cycle_args = argparse.Namespace(**vars(args))
    cycle_args.log_dir = str(cycle_log_dir(base, cycle))
    try:
        run_cycle(cycle_args)
    except (RuntimeError, OSError, ValueError, KeyError) as err:
        print(f"cycle failed: {err}", file=sys.stderr)


def pause(seconds: float) -> None:
    """Wait between watch cycles; the seam keeps a test off the shared clock."""
    time.sleep(seconds)


def main(argv: list[str] | None = None) -> int:
    """Run one batch, or watch cycles with a fresh log directory each time."""
    args = parse_args(argv)
    if args.watch and args.list:
        print("error: --watch and --list cannot be combined", file=sys.stderr)
        return 2
    if not args.watch:
        return run_cycle(args)
    base = Path(args.log_dir).expanduser() if args.log_dir else DEFAULT_CACHE / "logs"
    cycle = 0
    try:
        while True:
            run_watch_cycle(args, base, cycle)
            cycle += 1
            print(f"next cycle in {args.interval:.0f}s", file=sys.stderr)
            pause(args.interval)
    except KeyboardInterrupt:
        print("watch stopped", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
