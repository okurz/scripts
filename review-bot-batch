#!/usr/bin/env python3
"""Review many pull requests as the review bot, one isolated session per PR.

Reads every open PR of the scope with one GraphQL census (100 PRs per call), keeps the ones the
bot owes a review, and ranks them by the age of that obligation: C1 a head the bot's last decisive
review does not cover, C2 activity after a verdict on the current head, C3 never reviewed and
fresh, C4 never reviewed and stale, C5 nothing owed but asked for with ``--recheck``. A cycle
fills its slots by class with reserved slots for C3/C4 so no class starves, and appends the wait
per PR to ``<cache>/waits.csv``. Drafts, bot-authored PRs and heads the bot already covered are
dropped; ``--only-blocked`` narrows the batch to the PRs the bot still blocks. One review
session runs serially in the matching local checkout; a PR the bot still blocks on this head gets
a comment instead of a second block, while a new head gets a full verdict so the bot can lift its
own block. A session that finds nothing new posts no review and ends with ``--- REVIEW
SKIPPED``; its head is recorded in ``<cache>/skipped.json`` so a later cycle does not ask again.
The runner defaults to ``pi -p "/review-as-bot <url> --post"``; ``--runner opencode`` uses
``opencode run --command review-as-bot`` instead. Posting is the default; ``--dry-run``
prints each draft instead and leaves ``REVIEW_BOT_POST`` unset so the as-bot wrappers refuse
writes. ``--watch --interval N`` repeats the cycle and gives each cycle
its own log directory; ``--shard i/n`` restricts a batch to one residue class of PR numbers so
parallel batches cannot pick the same PR. A failing PR is reported and the batch continues.
"""

from __future__ import annotations

import argparse
import json
import os
import re
import subprocess
import sys
import time
from dataclasses import dataclass
from datetime import UTC, datetime, timedelta
from pathlib import Path
from typing import Any

BOT_FALLBACK = "os-autoinst-review"
DEFAULT_ROOTS = (Path.home() / "local" / "os-autoinst",)
DEFAULT_CACHE = Path.home() / ".cache" / "review-bot"
DEFAULT_LIMIT = 10
DEFAULT_TIMEOUT = 1200.0
DEFAULT_INTERVAL = 1200.0
REVIEW_STATES = frozenset({"APPROVED", "CHANGES_REQUESTED", "COMMENTED"})
REVIEW_ENTRY_FIELDS = 3
JQ_REVIEWS = '.[] | "\\(.user.login)\\t\\(.state)\\t\\(.commit_id)"'
SKIP_MARKER = "--- REVIEW SKIPPED"
SKIP_LEDGER = "skipped.json"
WAITS_FILE = "waits.csv"
WAIT_HEADER = "# v2 stamp,repo,number,cycle,class,owed_since,wait_seconds"
WAIT_COLUMNS_V2 = 7
WAIT_COLUMNS_V1 = 6
WAIT_RETENTION_DAYS = 7
MAX_WAIT_ROWS = 5000
CONFIRM_ATTEMPTS = 3
CONFIRM_WAITS_S = (2.0, 5.0)
FRESH_DAYS = 14
CLASS_ORDER = ("C1", "C2", "C3", "C4", "C5")
CLASS_RESERVES = {"C3": 1, "C4": 2}
LATENCY_CLASSES = ("C1", "C2", "C3", "C4")
LATENCY_TARGETS = {"C1": 3600.0, "C2": 4 * 3600.0, "C3": 86400.0}
C4_PER_CYCLE = 2.0
CENSUS_QUERY = """query($q: String!, $cursor: String) {
  search(query: $q, type: ISSUE, first: 100, after: $cursor) {
    pageInfo { hasNextPage endCursor }
    nodes { ... on PullRequest {
      number title isDraft createdAt updatedAt headRefOid
      repository { nameWithOwner }
      author { login }
      commits(last: 1) { nodes { commit { committedDate } } }
      reviews(last: 100) { nodes { author { login } state submittedAt commit { oid } } }
    } }
  }
}"""


@dataclass(frozen=True)
class Candidate:
    """An open PR that may be reviewed in this batch."""

    repo: str
    number: int
    title: str
    author: str
    created_at: str
    is_draft: bool = False

    @property
    def url(self) -> str:
        """Canonical PR URL passed to review-as-bot."""
        return f"https://github.com/{self.repo}/pull/{self.number}"

    @property
    def slug(self) -> str:
        """Filesystem-safe log name."""
        return f"{self.repo.replace('/', '-')}-{self.number}"


@dataclass(frozen=True)
class PrState:
    """Review state that decides priority and whether to post at all."""

    head: str
    reviewed_on_head: bool = False
    has_bot_block: bool = False
    blocked_on_head: bool = False


@dataclass(frozen=True)
class BotReview:
    """One review the bot submitted, as the census reports it."""

    state: str
    commit: str
    submitted_at: str


@dataclass(frozen=True)
class PrFacts:
    """Everything the census knows about one open PR, enough to rank it without another call."""

    repo: str
    number: int
    title: str
    author: str
    created_at: str
    updated_at: str
    head: str
    head_at: str
    is_draft: bool = False
    bot_reviews: tuple[BotReview, ...] = ()
    human_reviewers: int = 0

    @property
    def candidate(self) -> Candidate:
        """The review candidate this PR represents."""
        return Candidate(
            repo=self.repo,
            number=self.number,
            title=self.title,
            author=self.author,
            created_at=self.created_at,
            is_draft=self.is_draft,
        )

    @property
    def state(self) -> PrState:
        """Derive the review state from the bot reviews the census returned."""
        bot = [(review.state, review.commit) for review in self.bot_reviews]
        return PrState(
            head=self.head,
            reviewed_on_head=any(commit == self.head for _state, commit in bot),
            has_bot_block=still_blocked(bot),
            blocked_on_head=blocked_on_head(bot, self.head),
        )


@dataclass(frozen=True)
class ReviewOutcome:
    """One nested session: posted or approved, deliberately skipped, or failed."""

    ok: bool
    skipped: bool
    log: Path


@dataclass(frozen=True)
class Wait:
    """One ledger row: when the PR was reviewed, in which cycle, how urgent and how long it waited."""

    stamp: str
    cycle: str
    class_name: str
    seconds: float


@dataclass(frozen=True)
class Latency:
    """Latency of one urgency class over a ledger sample."""

    count: int
    max_seconds: float
    p95_seconds: float


def still_blocked(bot: list[tuple[str, str]]) -> bool:
    """Return whether the bot's latest decisive review requests changes (a comment neither blocks nor lifts)."""
    decisive = [(state, commit) for state, commit in bot if state != "COMMENTED"]
    return bool(decisive) and decisive[-1][0] == "CHANGES_REQUESTED"


def blocked_on_head(bot: list[tuple[str, str]], head: str) -> bool:
    """Return whether the bot's block covers this head, so a re-review can only comment."""
    return still_blocked(bot) and next((commit for state, commit in reversed(bot) if state != "COMMENTED"), "") == head


def run(cmd: list[str], *, cwd: Path | None = None) -> subprocess.CompletedProcess[str]:
    """Run a command and capture its output without raising on failure."""
    return subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, check=False)


def bot_login() -> str:
    """Return the review bot login, falling back to the known identity."""
    res = run(["gh-as-bot", "api", "user", "--jq", ".login"])
    return res.stdout.strip() if res.returncode == 0 and res.stdout.strip() else BOT_FALLBACK


def parse_github_repo(url: str) -> str | None:
    """Return ``owner/repo`` for a GitHub remote URL, else None."""
    match = re.search(r"github\.com[:/]([^/\s]+/[^/\s]+?)(?:\.git)?$", url.strip())
    return match.group(1) if match else None


def census_scopes(owners: list[str], repos: list[str]) -> list[str]:
    """Return one GraphQL search per owner and per repository."""
    scopes = [f"user:{owner} is:pr is:open archived:false" for owner in owners]
    return [*scopes, *(f"repo:{repo} is:pr is:open archived:false" for repo in repos)]


def facts_from_node(node: dict[str, Any], login: str) -> PrFacts:
    """Build the facts of one census node, keeping only the reviews of ``login`` as the bot's own."""
    reviews = [
        review for review in (node.get("reviews") or {}).get("nodes") or [] if review.get("state") in REVIEW_STATES
    ]
    logins = [(review.get("author") or {}).get("login", "") for review in reviews]
    author = (node.get("author") or {}).get("login", "")
    head = ((node.get("commits") or {}).get("nodes") or [{}])[0].get("commit") or {}
    return PrFacts(
        repo=node["repository"]["nameWithOwner"],
        number=int(node["number"]),
        title=node.get("title", ""),
        author=author,
        created_at=node.get("createdAt", ""),
        updated_at=node.get("updatedAt", ""),
        head=node.get("headRefOid", ""),
        head_at=head.get("committedDate", ""),
        is_draft=bool(node.get("isDraft")),
        bot_reviews=tuple(
            BotReview(
                state=review["state"],
                commit=(review.get("commit") or {}).get("oid", ""),
                submitted_at=review.get("submittedAt", ""),
            )
            for review, who in zip(reviews, logins, strict=True)
            if who == login
        ),
        human_reviewers=len({who for who in logins if who not in {login, author} and not who.endswith("[bot]")}),
    )


def fetch_census(owners: list[str], repos: list[str], login: str) -> list[PrFacts]:
    """Read every open PR of the scopes, one GraphQL search page of 100 PRs per call."""
    found: dict[tuple[str, int], PrFacts] = {}
    for search in census_scopes(owners, repos):
        cursor = ""
        while True:
            res = run([
                "gh-as-bot",
                "api",
                "graphql",
                "-f",
                f"query={CENSUS_QUERY}",
                "-f",
                f"q={search}",
                "-f",
                f"cursor={cursor}",
            ])
            if res.returncode != 0:
                msg = f"census failed for {search}: {res.stderr.strip()}"
                raise RuntimeError(msg)
            page = json.loads(res.stdout or "{}")["data"]["search"]
            for node in page["nodes"]:
                if node:
                    facts = facts_from_node(node, login)
                    found[facts.repo, facts.number] = facts
            if not page["pageInfo"]["hasNextPage"]:
                break
            cursor = page["pageInfo"]["endCursor"]
    return list(found.values())


def parse_stamp(value: str) -> datetime:
    """Parse one API timestamp."""
    return datetime.fromisoformat(value.strip())


def stamp_now() -> str:
    """Return the current UTC time in the form the API uses."""
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def stamp_days_ago(days: int) -> str:
    """Return the UTC stamp ``days`` before now."""
    return (datetime.now(UTC) - timedelta(days=days)).strftime("%Y-%m-%dT%H:%M:%SZ")


def wait_seconds(owed_since: str, *, now: str = "") -> float:
    """Return how long the bot has owed this PR, in seconds."""
    return (parse_stamp(now or stamp_now()) - parse_stamp(owed_since)).total_seconds()


def format_wait(seconds: float) -> str:
    """Render a wait as days, hours or minutes, whichever is the largest whole unit."""
    for unit, size in (("d", 86400), ("h", 3600), ("m", 60)):
        if seconds >= size:
            return f"{seconds / size:.0f}{unit}"
    return f"{seconds:.0f}s"


def obligation(facts: PrFacts, *, cutoff: str) -> tuple[str, str] | None:
    """Return the urgency class of a PR and the moment the bot came to owe it, None when nothing is owed.

    C1 is a head the bot's last decisive verdict does not cover, C2 activity after a verdict on this
    head, C3/C4 a PR the bot never reviewed at all, fresh or stale.
    """
    decisive = [review for review in facts.bot_reviews if review.state != "COMMENTED"]
    if decisive and decisive[-1].commit != facts.head:
        return "C1", facts.head_at
    if facts.state.reviewed_on_head and facts.bot_reviews and facts.updated_at > facts.bot_reviews[-1].submitted_at:
        return "C2", facts.bot_reviews[-1].submitted_at
    if facts.bot_reviews and not facts.state.reviewed_on_head:
        return "C1", facts.head_at
    if facts.bot_reviews:
        return None
    return ("C3" if facts.created_at >= cutoff else "C4"), facts.created_at


def pr_state(cand: Candidate, login: str) -> PrState:
    """Read the head sha and the bot's reviews of one PR."""
    view = run([
        "gh-as-bot",
        "pr",
        "view",
        str(cand.number),
        "-R",
        cand.repo,
        "--json",
        "headRefOid",
        "--jq",
        ".headRefOid",
    ])
    if view.returncode != 0:
        msg = f"cannot read head of {cand.repo}#{cand.number}: {view.stderr.strip()}"
        raise RuntimeError(msg)
    head = view.stdout.strip()
    reviews = run([
        "gh-as-bot",
        "api",
        "--paginate",
        f"repos/{cand.repo}/pulls/{cand.number}/reviews?per_page=100",
        "--jq",
        JQ_REVIEWS,
    ])
    if reviews.returncode != 0:
        msg = f"cannot read reviews of {cand.repo}#{cand.number}: {reviews.stderr.strip()}"
        raise RuntimeError(msg)
    entries = [line.split("\t") for line in reviews.stdout.splitlines()]
    entries = [entry for entry in entries if len(entry) == REVIEW_ENTRY_FIELDS and entry[1] in REVIEW_STATES]
    bot = [(state, commit) for user, state, commit in entries if user == login]
    return PrState(
        head=head,
        reviewed_on_head=any(commit == head for _state, commit in bot),
        has_bot_block=still_blocked(bot),
        blocked_on_head=blocked_on_head(bot, head),
    )


def skip_key(repo: str, number: int) -> str:
    """Return the cache key that records a deliberately skipped PR."""
    return f"{repo}#{number}"


def load_skips(path: Path) -> dict[str, str]:
    """Read the recorded skip heads, treating a missing or malformed cache as empty."""
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    if not isinstance(data, dict):
        return {}
    return {key: head for key, head in data.items() if isinstance(head, str)}


def save_skips(path: Path, skips: dict[str, str]) -> None:
    """Persist the skip heads so the next cycle does not ask the same question."""
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(json.dumps(skips, indent=0, sort_keys=True) + "\n", encoding="utf-8")


def record_skip(path: Path, cand: Candidate, state: PrState, skips: dict[str, str]) -> None:
    """Remember that this head needs no review; a new head makes the PR eligible again."""
    skips[skip_key(cand.repo, cand.number)] = state.head
    save_skips(path, skips)


def record_wait(path: Path, cand: Candidate, owed: tuple[str, str], *, cycle: str, now: str = "") -> float:
    """Append one reviewed PR to the latency ledger and return how long it waited."""
    seconds = wait_seconds(owed[1], now=now)
    path.parent.mkdir(parents=True, exist_ok=True)
    fresh = not path.exists() or path.stat().st_size == 0
    with path.open("a", encoding="utf-8") as handle:
        if fresh:
            handle.write(f"{WAIT_HEADER}\n")
        row = f"{now or stamp_now()},{cand.repo},{cand.number},{cycle},{owed[0]},{owed[1]},{seconds:.0f}"
        handle.write(f"{row}\n")
    trim_waits(path)
    return seconds


def trim_waits(path: Path, *, keep: int = 0) -> None:
    """Drop the oldest rows once the ledger outgrows ``MAX_WAIT_ROWS``, keeping its header."""
    lines = path.read_text(encoding="utf-8").splitlines()
    rows = [line for line in lines if line and not line.startswith("#")]
    if len(rows) <= MAX_WAIT_ROWS:
        return
    header = [line for line in lines if line.startswith("#")]
    path.write_text("\n".join([*header, *rows[-(keep or MAX_WAIT_ROWS // 2) :]]) + "\n", encoding="utf-8")


def parse_wait(line: str) -> Wait | None:
    """Read one ledger row, accepting the six-column v1 and the seven-column v2 form."""
    fields = line.split(",")
    try:
        if len(fields) == WAIT_COLUMNS_V2:
            return Wait(fields[0], fields[3], fields[4], float(fields[6]))
        if len(fields) == WAIT_COLUMNS_V1:
            return Wait(fields[0], "", fields[3], float(fields[5]))
    except ValueError:
        return None
    return None


def load_waits(path: Path, *, since_days: int = WAIT_RETENTION_DAYS) -> list[Wait]:
    """Read the ledger rows of the last ``since_days``, skipping headers, junk and old rows."""
    cutoff = stamp_days_ago(since_days)
    try:
        lines = path.read_text(encoding="utf-8").splitlines()
    except OSError:
        return []
    waits = [parse_wait(line) for line in lines if line and not line.startswith("#")]
    return [wait for wait in waits if wait and wait.stamp >= cutoff]


def latency(waits: list[Wait], class_name: str) -> Latency | None:
    """Summarise one class: how often it was served, its worst and its 95th percentile wait."""
    sample = sorted(wait.seconds for wait in waits if wait.class_name == class_name)
    if not sample:
        return None
    rank = min(len(sample) - 1, round(0.95 * (len(sample) - 1)))
    return Latency(count=len(sample), max_seconds=sample[-1], p95_seconds=sample[rank])


def throughput(waits: list[Wait], class_name: str) -> float:
    """Return the rows of one class per distinct cycle, the rate promise of the backlog class."""
    sample = [wait for wait in waits if wait.class_name == class_name]
    return len(sample) / len({wait.cycle for wait in sample}) if sample else 0.0


def latency_report(waits: list[Wait]) -> str:
    """Render the per-class latency and backlog rate of one ledger sample on a single line."""
    parts = []
    for class_name in LATENCY_CLASSES:
        summary = latency(waits, class_name)
        if summary is None:
            parts.append(f"{class_name} none")
        elif class_name == "C4":
            parts.append(f"C4 {throughput(waits, class_name):.1f}/cycle n={summary.count}")
        else:
            worst = format_wait(summary.max_seconds)
            typical = format_wait(summary.p95_seconds)
            parts.append(f"{class_name} max {worst} p95 {typical} n={summary.count}")
    return " · ".join(parts)


def breaches(waits: list[Wait], *, targets: dict[str, float] | None = None) -> list[str]:
    """Name every class that misses its target, and the empty sample that proves nothing."""
    targets = LATENCY_TARGETS if targets is None else targets
    if not waits:
        return ["no ledger rows in the retention window"]
    problems = []
    for class_name, target in targets.items():
        summary = latency(waits, class_name)
        if summary and summary.max_seconds > target:
            problems.append(f"{class_name} max wait {format_wait(summary.max_seconds)} exceeds {format_wait(target)}")
    served = throughput(waits, "C4")
    if served < C4_PER_CYCLE:
        problems.append(f"C4 serves {served:.1f} per cycle, target {C4_PER_CYCLE:.0f}")
    return problems


def report_waits(cache: Path, *, since_days: int = WAIT_RETENTION_DAYS) -> list[Wait]:
    """Print the latency summary of the ledger window and return the rows behind it."""
    waits = load_waits(cache / WAITS_FILE, since_days=since_days)
    print(f"waits {since_days}d: {latency_report(waits)}", file=sys.stderr)
    return waits


def latency_gate(args: argparse.Namespace) -> int:
    """Report the ledger and fail when a class misses its target: the check a timer runs."""
    problems = breaches(report_waits(cache_dir(args), since_days=args.since_days))
    for problem in problems:
        print(f"breach: {problem}", file=sys.stderr)
    return 1 if problems else 0


def parse_shard(value: str) -> tuple[int, int]:
    """Parse ``i/n`` into a one-based shard index and its count."""
    match = re.fullmatch(r"(\d+)/(\d+)", value.strip())
    if not match or not 1 <= int(match.group(1)) <= int(match.group(2)):
        msg = f"expected i/n with 1 <= i <= n, got {value!r}"
        raise argparse.ArgumentTypeError(msg)
    return int(match.group(1)), int(match.group(2))


def cache_dir(args: argparse.Namespace) -> Path:
    """Return the cache directory holding the skip ledger and the latency ledger."""
    return Path(args.cache).expanduser() if args.cache else DEFAULT_CACHE


def owed_work(
    found: list[PrFacts],
    login: str,
    *,
    skips: dict[str, str],
    cutoff: str,
    include_bots: bool = False,
    only_blocked: bool = False,
    recheck: bool = False,
    shard: tuple[int, int] | None = None,
) -> tuple[list[Candidate], dict[tuple[str, int], tuple[str, str]]]:
    """Return the PRs that owe the bot work and, per PR, the urgency class and the owed-since stamp."""
    owed: dict[tuple[str, int], tuple[str, str]] = {}
    for facts in found:
        if facts.is_draft or facts.author == login or (not include_bots and facts.author.endswith("[bot]")):
            continue
        if shard and facts.number % shard[1] != shard[0] % shard[1]:
            continue
        state = facts.state
        if only_blocked and not state.has_bot_block:
            continue
        if not recheck and skips.get(skip_key(facts.repo, facts.number)) == state.head:
            continue
        due = obligation(facts, cutoff=cutoff) or (("C5", facts.updated_at) if recheck else None)
        if due:
            owed[facts.repo, facts.number] = due
    return [facts.candidate for facts in found if (facts.repo, facts.number) in owed], owed


def group_by_class(
    candidates: list[Candidate], owed: dict[tuple[str, int], tuple[str, str]]
) -> dict[str, list[Candidate]]:
    """Bucket the candidates by urgency class, oldest obligation first inside a class."""
    by_class: dict[str, list[Candidate]] = {}
    for cand in candidates:
        by_class.setdefault(owed[cand.repo, cand.number][0], []).append(cand)
    for bucket in by_class.values():
        bucket.sort(key=lambda cand: owed[cand.repo, cand.number][1])
    return by_class


def take_class(
    by_class: dict[str, list[Candidate]],
    offsets: dict[str, int],
    chosen: list[Candidate],
    *,
    class_name: str,
    count: int,
    limit: int,
) -> None:
    """Append up to ``count`` more PRs of one class, never exceeding ``limit`` in total."""
    bucket = by_class.get(class_name, [])
    start = offsets.get(class_name, 0)
    end = min(len(bucket), start + max(0, count), start + max(0, limit - len(chosen)))
    chosen.extend(bucket[start:end])
    offsets[class_name] = end


def select_owed(
    candidates: list[Candidate],
    owed: dict[tuple[str, int], tuple[str, str]],
    limit: int,
    *,
    reserves: dict[str, int] | None = None,
) -> list[Candidate]:
    """Fill a cycle by class order with slots held back for the backlog, so no class starves.

    C1/C2 are filled first, but only up to ``limit`` minus half of the held slots, so a flood of
    freshly invalidated reviews cannot push the C3/C4 reserves out of the cycle.
    """
    reserves = CLASS_RESERVES if reserves is None else reserves
    by_class = group_by_class(candidates, owed)
    held = sum(min(count, limit) for count in reserves.values())
    chosen: list[Candidate] = []
    offsets: dict[str, int] = {}
    urgent = max(0, limit - min(held, limit // 2))
    for class_name in ("C1", "C2"):
        take_class(by_class, offsets, chosen, class_name=class_name, count=max(0, urgent - len(chosen)), limit=limit)
    for class_name, count in reserves.items():
        take_class(by_class, offsets, chosen, class_name=class_name, count=count, limit=limit)
    for class_name in CLASS_ORDER:
        take_class(by_class, offsets, chosen, class_name=class_name, count=limit, limit=limit)
    chosen.sort(key=lambda cand: (CLASS_ORDER.index(owed[cand.repo, cand.number][0]), owed[cand.repo, cand.number][1]))
    return chosen


def discover_checkouts(roots: list[Path] | tuple[Path, ...]) -> dict[str, Path]:
    """Map ``owner/repo`` to a local checkout under the given roots."""
    found: dict[str, Path] = {}
    for root in roots:
        if not root.is_dir():
            continue
        for config in sorted(root.glob("*/.git/config")):
            checkout = config.parent.parent
            res = run(["git", "-C", str(checkout), "remote", "get-url", "origin"])
            repo = parse_github_repo(res.stdout) if res.returncode == 0 else None
            if repo and repo not in found:
                found[repo] = checkout
    return found


def ensure_checkout(repo: str, checkouts: dict[str, Path], cache: Path, *, allow_clone: bool) -> Path:
    """Return a local checkout for the repo, cloning into the cache if allowed."""
    if repo in checkouts:
        return checkouts[repo]
    target = cache / repo.replace("/", "-")
    if target.is_dir():
        return target
    if not allow_clone:
        msg = f"no local checkout for {repo} (use without --no-clone to clone)"
        raise RuntimeError(msg)
    target.parent.mkdir(parents=True, exist_ok=True)
    res = run(["git", "clone", "--filter=blob:none", "--no-checkout", f"https://github.com/{repo}.git", str(target)])
    if res.returncode != 0:
        msg = f"cannot clone {repo}: {res.stderr.strip()}"
        raise RuntimeError(msg)
    return target


def fetch_pr_head(checkout: Path, number: int) -> None:
    """Fetch the PR head ref so the review session can create a worktree from it."""
    res = run(["git", "-C", str(checkout), "fetch", "--no-tags", "origin", f"refs/pull/{number}/head"])
    if res.returncode != 0:
        msg = f"cannot fetch PR head for #{number}: {res.stderr.strip()}"
        raise RuntimeError(msg)


def review_command(
    cand: Candidate,
    checkout: Path,
    *,
    runner: str = "pi",
    dry_run: bool,
    model: str = "",
    auto: bool = False,
    comment_only: bool = False,
    extra_args: list[str] | None = None,
) -> list[str]:
    """Build the nested review invocation for one PR with the selected runner."""
    mode = "--dry-run" if dry_run else "--post"
    suffix = " --comment" if comment_only else ""
    extra = extra_args or []
    if runner == "opencode":
        flags = [*(["--auto"] if auto else []), *(["-m", model] if model else []), *extra]
        return [
            "opencode",
            "run",
            "--dir",
            str(checkout.resolve()),
            *flags,
            "--command",
            "review-as-bot",
            f"{cand.url} {mode}{suffix}",
        ]
    flags = [*(["--model", model] if model else []), *extra]
    return ["pi", *flags, "-p", f"/review-as-bot {cand.url} {mode}{suffix}"]


def runner_env(*, dry_run: bool, report: Path | None = None) -> dict[str, str]:
    """Environment for the nested runner; the as-bot wrappers refuse writes without REVIEW_BOT_POST."""
    env = dict(os.environ)
    env.pop("REVIEW_BOT_POST", None)
    env.pop("REVIEW_BOT_REPORT", None)
    if not dry_run:
        env["REVIEW_BOT_POST"] = "1"
        if report is not None:
            env["REVIEW_BOT_REPORT"] = str(report)
    return env


def review_succeeded(returncode: int, output: str) -> bool:
    """Treat a claimed block or a failed run as unsuccessful even on exit 0."""
    blocked = "--- REVIEW FAILED" in output or "--- REVIEW BLOCKED" in output
    return returncode == 0 and not blocked


def review_skipped(output: str) -> bool:
    """Return whether the session had nothing new and posted no review on purpose."""
    return SKIP_MARKER in output


def run_review(
    cand: Candidate,
    checkout: Path,
    *,
    runner: str = "pi",
    dry_run: bool,
    model: str = "",
    auto: bool = False,
    comment_only: bool = False,
    extra_args: list[str] | None = None,
    log_dir: Path,
    timeout: float,
) -> ReviewOutcome:
    """Run one review session and tee its output to a log."""
    fetch_pr_head(checkout, cand.number)
    log_dir.mkdir(parents=True, exist_ok=True)
    log = log_dir / f"{cand.slug}.log"
    cmd = review_command(
        cand,
        checkout,
        runner=runner,
        dry_run=dry_run,
        model=model,
        auto=auto,
        comment_only=comment_only,
        extra_args=extra_args,
    )
    timed_out = False
    with log.open("w", encoding="utf-8") as handle:
        try:
            res = subprocess.run(
                cmd,
                cwd=checkout,
                env=runner_env(dry_run=dry_run, report=log_dir / f"{cand.slug}.report.md"),
                stdout=handle,
                stderr=subprocess.STDOUT,
                check=False,
                timeout=timeout,
            )
        except subprocess.TimeoutExpired:
            timed_out = True
    if timed_out:
        with log.open("a", encoding="utf-8") as handle:
            handle.write(f"\n--- REVIEW FAILED (timeout after {timeout:.0f}s) ---\n")
        return ReviewOutcome(ok=False, skipped=False, log=log)
    output = log.read_text(encoding="utf-8", errors="replace")
    return ReviewOutcome(ok=review_succeeded(res.returncode, output), skipped=review_skipped(output), log=log)


def pause(seconds: float) -> None:
    """Wait between watch cycles and between confirmation reads; the seam keeps tests off the clock."""
    time.sleep(seconds)


def confirm_posted(cand: Candidate, login: str, outcome: ReviewOutcome, *, dry_run: bool) -> tuple[bool, str]:
    """Return whether the review is visible on the head, and why not when it is not.

    The API is the source of truth, so a review that is still propagating is re-read a bounded
    number of times before the post counts as failed.
    """
    if outcome.skipped or dry_run:
        return outcome.ok, ""
    reason = ""
    for attempt in range(CONFIRM_ATTEMPTS):
        if attempt:
            pause(CONFIRM_WAITS_S[attempt - 1])
        try:
            state = pr_state(cand, login)
        except RuntimeError as err:
            reason = str(err)
            continue
        if state.reviewed_on_head:
            return True, ""
        reason = f"review not visible on {state.head}"
    return False, reason


def cycle_log_dir(base: Path, cycle: int) -> Path:
    """Return a unique log directory for one watch cycle."""
    return base / f"{time.strftime('%Y%m%d-%H%M%S')}-{cycle:03d}"


def infer_owner() -> str:
    """Infer the GitHub owner from the current checkout's origin."""
    res = run(["git", "remote", "get-url", "origin"])
    repo = parse_github_repo(res.stdout) if res.returncode == 0 else None
    return repo.split("/")[0] if repo else ""


def parse_args(argv: list[str] | None = None) -> argparse.Namespace:
    """Parse the command line."""
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument(
        "--owner", action="append", default=[], help="GitHub org/user to review, repeatable (default: inferred)"
    )
    parser.add_argument("-R", "--repo", action="append", default=[], dest="repos", help="owner/repo, repeatable")
    parser.add_argument(
        "--limit", type=int, default=DEFAULT_LIMIT, help=f"max PRs to review (default: {DEFAULT_LIMIT})"
    )
    parser.add_argument("--list", action="store_true", help="print the selected PRs and exit without reviewing")
    parser.add_argument(
        "--latency-report",
        action="store_true",
        help="print the latency ledger and exit non-zero when a class misses its target",
    )
    parser.add_argument(
        "--since-days", type=int, default=WAIT_RETENTION_DAYS, help="ledger window to report on (default: 7)"
    )
    parser.add_argument(
        "--timeout",
        type=float,
        default=DEFAULT_TIMEOUT,
        help=f"seconds per PR before killing the nested runner (default: {DEFAULT_TIMEOUT:.0f})",
    )
    parser.add_argument("--watch", action="store_true", help="run cycles continuously instead of exiting")
    parser.add_argument(
        "--interval",
        type=float,
        default=DEFAULT_INTERVAL,
        help=f"seconds between watch cycles (default: {DEFAULT_INTERVAL:.0f})",
    )
    parser.add_argument("--dry-run", action="store_true", help="print each draft instead of posting (default: post)")
    parser.add_argument(
        "--recheck",
        action="store_true",
        help="also review heads the bot already reviewed or skipped as having nothing new",
    )
    parser.add_argument(
        "--only-blocked",
        action="store_true",
        help="only consider PRs the bot still blocks with a changes-requested review",
    )
    parser.add_argument("--include-bots", action="store_true", help="include PRs authored by dependency bots")
    parser.add_argument("--no-clone", action="store_true", help="skip repos with no local checkout instead of cloning")
    parser.add_argument("--root", action="append", default=[], dest="roots", help="checkout root, repeatable")
    parser.add_argument(
        "--cache", default="", help=f"cache directory holding the skip and latency ledgers (default: {DEFAULT_CACHE})"
    )
    parser.add_argument(
        "--shard",
        type=parse_shard,
        default=None,
        help="review only PRs where number %% N == I %% N of this i/n shard, for overlap-free parallel batches",
    )
    parser.add_argument("--log-dir", default="", help="directory for per-PR logs (default: ~/.cache/review-bot/logs)")
    parser.add_argument(
        "--runner",
        choices=("pi", "opencode"),
        default="pi",
        help="nested review runner (default: pi)",
    )
    parser.add_argument("--model", default="", help="model passed to the nested runner (opencode: -m, pi: --model)")
    parser.add_argument("--auto", action="store_true", help="pass --auto to opencode to auto-approve permissions")
    parser.add_argument(
        "--runner-arg",
        "--pi-arg",
        action="append",
        default=[],
        dest="runner_args",
        help="extra argument for the nested runner, repeatable; use --runner-arg=--flag for dash values",
    )
    return parser.parse_args(argv)


def review_candidate(
    cand: Candidate,
    state: PrState,
    owed: tuple[str, str],
    *,
    args: argparse.Namespace,
    checkouts: dict[str, Path],
    log_dir: Path,
    login: str,
    skips: dict[str, str],
    cache: Path,
) -> bool:
    """Review one candidate and return whether its head now needs no further review."""
    label = f"{owed[0]} {format_wait(wait_seconds(owed[1]))}"
    print(f"reviewing {cand.repo}#{cand.number} ({label}): {cand.title[:60]}", file=sys.stderr)
    try:
        checkout = ensure_checkout(cand.repo, checkouts, DEFAULT_CACHE, allow_clone=not args.no_clone)
        outcome = run_review(
            cand,
            checkout,
            runner=args.runner,
            dry_run=args.dry_run,
            model=args.model,
            auto=args.auto,
            comment_only=state.blocked_on_head,
            extra_args=args.runner_args,
            log_dir=log_dir,
            timeout=args.timeout,
        )
    except RuntimeError as err:
        print(f"FAILED  {cand.repo}#{cand.number}: {err}", file=sys.stderr)
        return False
    if outcome.skipped:
        record_skip(cache / SKIP_LEDGER, cand, state, skips)
    if not args.dry_run:
        record_wait(cache / WAITS_FILE, cand, owed, cycle=log_dir.name)
    ok, reason = confirm_posted(cand, login, outcome, dry_run=args.dry_run)
    status = "skip" if outcome.skipped else ("ok" if ok else "FAILED")
    detail = f"  {reason}" if reason else ""
    print(f"{status}  {cand.repo}#{cand.number}  {label}  log={outcome.log}{detail}", file=sys.stderr)
    return ok


def review_selected(
    selected: list[Candidate],
    owed: dict[tuple[str, int], tuple[str, str]],
    found: list[PrFacts],
    *,
    args: argparse.Namespace,
    login: str,
    skips: dict[str, str],
    cache: Path,
) -> int:
    """Review the selected PRs serially and return the number of failures."""
    roots = [Path(root).expanduser() for root in args.roots] or list(DEFAULT_ROOTS)
    checkouts = discover_checkouts(roots)
    log_dir = Path(args.log_dir).expanduser() if args.log_dir else cache / "logs"
    states = {(facts.repo, facts.number): facts.state for facts in found}
    failures = 0
    for cand in selected:
        if not review_candidate(
            cand,
            states[cand.repo, cand.number],
            owed[cand.repo, cand.number],
            args=args,
            checkouts=checkouts,
            log_dir=log_dir,
            login=login,
            skips=skips,
            cache=cache,
        ):
            failures += 1
    return failures


def run_cycle(args: argparse.Namespace) -> int:
    """Run one census, classify, select and review cycle and return a shell exit code."""
    owners = [owner for owner in (args.owner or ([infer_owner()] if not args.repos else [])) if owner]
    if not owners and not args.repos:
        print("error: give --owner or -R owner/repo (or run inside a checkout)", file=sys.stderr)
        return 2
    login = bot_login()
    cache = cache_dir(args)
    try:
        found = fetch_census(owners, args.repos, login)
    except (RuntimeError, OSError, ValueError, KeyError) as err:
        print(f"census failed: {err}", file=sys.stderr)
        return 1
    skips = load_skips(cache / SKIP_LEDGER)
    candidates, owed = owed_work(
        found,
        login,
        skips=skips,
        cutoff=stamp_days_ago(FRESH_DAYS),
        include_bots=args.include_bots,
        only_blocked=args.only_blocked,
        recheck=args.recheck,
        shard=args.shard,
    )
    print(f"census: {len(found)} open PRs, {len(owed)} owed, {len(candidates)} eligible", file=sys.stderr)
    selected = select_owed(candidates, owed, args.limit)
    if not selected:
        print(f"nothing owed for {', '.join(args.repos or owners)}", file=sys.stderr)
        return 0
    if args.list:
        for cand in selected:
            cls, since = owed[cand.repo, cand.number]
            print(f"{cand.repo}#{cand.number}\t{cls}\t{since[:10]}\t{cand.author}\t{cand.title}")
        return 0
    mode = "dry-run" if args.dry_run else "post"
    print(f"{len(selected)} PR(s), mode={mode}, reviewer={login}", file=sys.stderr)
    failures = review_selected(selected, owed, found, args=args, login=login, skips=skips, cache=cache)
    print(f"done: {len(selected) - failures} ok, {failures} failed", file=sys.stderr)
    report_waits(cache)
    return 1 if failures else 0


def run_watch_cycle(args: argparse.Namespace, base: Path, cycle: int) -> None:
    """Run one watch cycle with its own log directory, keeping the loop alive on failure."""
    cycle_args = argparse.Namespace(**vars(args))
    cycle_args.log_dir = str(cycle_log_dir(base, cycle))
    try:
        run_cycle(cycle_args)
    except (RuntimeError, OSError, ValueError, KeyError) as err:
        print(f"cycle failed: {err}", file=sys.stderr)


def main(argv: list[str] | None = None) -> int:
    """Run one batch, or watch cycles with a fresh log directory each time."""
    args = parse_args(argv)
    if args.latency_report and (args.watch or args.list):
        print("error: --latency-report cannot be combined with --watch or --list", file=sys.stderr)
        return 2
    if args.latency_report:
        return latency_gate(args)
    if args.watch and args.list:
        print("error: --watch and --list cannot be combined", file=sys.stderr)
        return 2
    if not args.watch:
        return run_cycle(args)
    base = Path(args.log_dir).expanduser() if args.log_dir else DEFAULT_CACHE / "logs"
    cycle = 0
    try:
        while True:
            run_watch_cycle(args, base, cycle)
            cycle += 1
            print(f"next cycle in {args.interval:.0f}s", file=sys.stderr)
            pause(args.interval)
    except KeyboardInterrupt:
        print("watch stopped", file=sys.stderr)
        return 130


if __name__ == "__main__":
    sys.exit(main())
